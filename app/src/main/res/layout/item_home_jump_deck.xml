<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/jumpDeckCard"
    android:layout_width="260dp"
    android:layout_height="200dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/jumpDeckCourse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_round_999"
                android:backgroundTint="#22000000"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textColor="#DD000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jumpDeckIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_round_10"
                android:backgroundTint="#1F000000"
                android:gravity="center"
                android:textColor="#CC000000"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/jumpDeckName"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:gravity="bottom"
            android:lineSpacingExtra="2dp"
            android:textColor="#DD000000"
            android:textSize="31sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/jumpDeckDue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#C0000000"
                android:textSize="13sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_round_999"
                android:backgroundTint="#D9000000"
                android:gravity="center"
                android:text=">"
                android:textColor="@color/white"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
